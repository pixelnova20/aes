# 文件作用：提供 Courseworks 数据库、认证、工作区、Docker 沙箱和 Provider 网络策略的环境变量模板。
# 模块位置：仓库根目录，属于部署配置示例；安装者应复制为 .env 并替换示例值。
# 重要配置：DATABASE_URL/JWT_SECRET 控制后端安全，WORKSPACE_ROOT 定位学生目录，DOCKER_* 限制沙箱资源和网络。
DATABASE_URL="mysql://vibeos_user:replace_password@localhost:3306/vibeos_agent"
JWT_SECRET="replace-with-a-long-random-secret"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=3000
# Replace /absolute/path/to/aes when configuring this file manually. The root installer fills these paths automatically.
HOMEWORKS_ACCOUNT_DATABASE_PATH="/absolute/path/to/aes/accounts-data/accounts.db"
HOMEWORKS_COURSE_DATABASE_PATH="/absolute/path/to/aes/accounts-data/courses.db"
HOMEWORKS_UPLOAD_PATH="/absolute/path/to/aes/homeworks/uploads"
HOMEWORKS_PUBLIC_PATH="/homeworks"
SLIDESHOW_DATABASE_PATH="/absolute/path/to/aes/accounts-data/slideshow.db"
SLIDESHOW_UPLOAD_PATH="/absolute/path/to/aes/slideshow/uploads"
SLIDESHOW_PUBLIC_PATH="/slideshow"
ARCHIVE_ROOT="/absolute/path/to/aes/archive-data"
WORKSPACE_ROOT="/absolute/path/to/aes/courseworks/student-workspace"



DOCKER_TOOLBOX_IMAGE="courseworks-toolbox:latest"
DOCKER_RESTRICTED_NETWORK="courseworks-restricted"
# Used by docker/toolbox/setup-restricted-network.sh. Student container egress
# should leave through the host's direct physical interface, not tun0/v2ray.
# Leave empty to detect the interface from the default route.
DOCKER_DIRECT_IFACE=""
# These are lower per-container profiles. superuser.toml applies the common
# CPU, memory and process safety ceilings without raising lighter profiles.
DOCKER_RUNNER_CPUS=1
DOCKER_RUNNER_MEMORY="768m"
DOCKER_RUNNER_PIDS_LIMIT=128
DOCKER_AGENT_CPUS=1
DOCKER_AGENT_MEMORY="768m"
DOCKER_AGENT_PIDS_LIMIT=128
DOCKER_SHELL_CPUS=0.5
DOCKER_SHELL_MEMORY="512m"
DOCKER_SHELL_PIDS_LIMIT=128
DOCKER_QEMU_CPUS=1
DOCKER_QEMU_MEMORY="1g"
DOCKER_QEMU_PIDS_LIMIT=192
DOCKER_RUNTIME_CPUS=0.1
DOCKER_RUNTIME_MEMORY="128m"
DOCKER_RUNTIME_PIDS_LIMIT=32
DOCKER_PROVIDER_CPUS=0.25
DOCKER_PROVIDER_MEMORY="128m"
DOCKER_PROVIDER_PIDS_LIMIT=32
EXECUTION_GLOBAL_CPU_BUDGET=6
EXECUTION_GLOBAL_MEMORY_BUDGET="18g"
EXECUTION_MAX_HEAVY_PER_WORKSPACE=1
EXECUTION_ADMISSION_QUEUE_TIMEOUT_MS=30000
EXECUTION_MONITOR_INTERVAL_MS=2000
EXECUTION_CPU_HOG_THRESHOLD=0.95
EXECUTION_CPU_HOG_DURATION_MS=30000
EXECUTION_MEMORY_HOG_THRESHOLD=0.9
EXECUTION_PID_HOG_THRESHOLD=0.9
EXECUTION_MEMORY_PID_DURATION_MS=5000
EXECUTION_SESSION_MAX_LIFETIME_MS=7200000
EXECUTION_OUTPUT_MAX_BYTES=1048576
EXECUTION_OUTPUT_RATE_BYTES_PER_SEC=2097152
EXECUTION_OUTPUT_RATE_DURATION_MS=5000
EXECUTION_TOOL_TIMEOUT_DEFAULT_SECONDS=30
EXECUTION_TOOL_TIMEOUT_HARD_MAX_SECONDS=60
DEFAULT_AI_TEMPERATURE=0.7
AGENT_LLM_TIMEOUT_MS=600000


WEB_SEARCH_PROVIDER="bing"
# Brave Search API key is optional. If set with WEB_SEARCH_PROVIDER="brave", it is used instead of DuckDuckGo HTML fallback.
WEB_SEARCH_API_KEY=""
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=10000
